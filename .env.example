SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_SECRET=change-this-worker-secret

ADMIN_RESET_KEY=change-this-admin-reset-key
ADMIN_USERS=your_admin_username

# Optional, only if email OTP reset is enabled later.
RESEND_API_KEY=re_xxxxxxxxx
RESET_FROM_EMAIL=FORCE <noreply@forcecommunity.id>
RESET_REPLY_TO_EMAIL=forcecommunity@gmail.com

# Optional FORCE Shops notification automation.
# When empty, orders are still saved in Supabase and can be handled manually.
N8N_SHOP_WEBHOOK_URL=https://your-n8n-domain.com/webhook/force-shop-order
N8N_SHOP_WEBHOOK_SECRET=change-this-long-random-secret
